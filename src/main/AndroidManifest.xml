<application
    android:allowBackup="true"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:requestLegacyExternalStorage="true"
    android:theme="@style/Theme.ExltoTts"
    tools:targetApi="31">

    <activity
        android:name=".ui.MainActivity"
        android:exported="true"
        android:theme="@style/Theme.ExltoTts">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>

    <activity
        android:name=".ui.PreviewActivity"
        android:exported="false"
        android:label="@string/preview_title"
        android:parentActivityName=".ui.MainActivity"
        android:theme="@style/Theme.ExltoTts" />

    <activity
        android:name=".ui.TTSActivity"
        android:exported="false"
        android:label="@string/tts_activity_title"
        android:parentActivityName=".ui.PreviewActivity"
        android:screenOrientation="portrait"
        android:theme="@style/Theme.ExltoTts" />

</application>